# Copy to .env and fill in. Never commit .env.
# Without a key the app runs fully in mock mode.
GEMINI_API_KEY=

# Optional — same names on Vercel (Project → Settings → Environment Variables)
# GEMINI_LIVE_MODEL=gemini-3.8-live
# LIVE_ASYNC_TOOLS=true            # set false for models without non-blocking tools
# ALLOWED_ORIGINS=https://gamingflexer.github.io,http://localhost:5173
#                                  # browser origins allowed to call /api/live-token and /api/summary.
#                                  # The same host as the API is always allowed. Requests with NO Origin
#                                  # header (the React Native app, curl) are allowed but still rate-limited.
# LIVE_TOKEN_DAILY_CAP=200         # live-talk tokens per UTC day (per server instance)
# LIVE_TOKEN_PER_MIN=6             # live-talk tokens per IP per minute
# SUMMARY_MODEL=gemini-flash-lite-latest   # short doctor note on S13
# SUMMARY_DAILY_CAP=300
# SUMMARY_PER_MIN=10
# PORT=8787                        # Express only

# Client (Vite) — where the static PWA finds the token server.
# Empty = same origin (local dev uses the Vite proxy; on Vercel the API is same origin).
# VITE_LIVE_SERVER_URL=
