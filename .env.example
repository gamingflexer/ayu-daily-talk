# Copy to .env and fill in. Never commit .env.
# Without a key the app runs fully in mock mode.
GEMINI_API_KEY=

# Optional
# GEMINI_LIVE_MODEL=gemini-3.8-live
# LIVE_ASYNC_TOOLS=true          # set false for models without non-blocking tools
# PORT=8787
# ALLOWED_ORIGINS=https://gamingflexer.github.io,http://localhost:5173

# Client (Vite) — where the static PWA finds the token server.
# Empty = same origin (local dev uses the Vite proxy). On GitHub Pages leave empty for mock-only.
# VITE_LIVE_SERVER_URL=
