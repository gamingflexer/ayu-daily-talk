# Copy to .env and fill in. Never commit .env.
# Without a key the app still works: Tell Ayu says it can't listen right now and
# offers the quick taps; the daily check and the ASHA app run on the phone.
GEMINI_API_KEY=

# Optional — same names on Vercel (Project → Settings → Environment Variables)
# GEMINI_LIVE_MODEL=gemini-3.8-live
# ALLOWED_ORIGINS=https://gamingflexer.github.io,http://localhost:5173
#                                  # browser origins (besides the API's own host) allowed to call
#                                  # /api/live-token. A POST without an Origin header is refused.
# LIVE_TOKEN_DAILY_CAP=200         # Tell Ayu sessions (tokens) per UTC day (per server instance)
# LIVE_TOKEN_PER_MIN=6             # tokens per IP per minute
# PAGE_PASS_SECRET=                # signs the 10-minute page pass from /api/health (default: derived from the key)
# PORT=8787                        # Express only

# Client (Vite) — where the static PWA finds the token server.
# Empty = same origin (local dev uses the Vite proxy; on Vercel the API is same origin).
# VITE_LIVE_SERVER_URL=

# Question sets an ASHA drafts with Ayu (POST /api/draft-questions)
# DRAFT_MODEL=gemini-flash-lite-latest
# DRAFT_DAILY_CAP=100
# DRAFT_PER_MIN=4
