rules_version = '2';
// Ayu daily talk — research store (project ayu-daily-talk-research).
// Phones may ADD one record per finished talk or check. Nobody can read, change
// or delete through the app; read them in the Firebase console.
// Records hold no name or phone (see docs/RESEARCH-DATA.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /talks/{id} {
      allow create: if request.resource.data.keys().hasOnly(['v', 'kind', 'device', 'at', 'endedAt', 'lang', 'stage', 'weeks', 'daysAfterBirth', 'setId', 'turns', 'answers', 'signs', 'confirmed', 'removed', 'level', 'rule', 'items', 'camera', 'endedBy', 'model', 'app', 'client'])
        && request.resource.data.v == 1
        && request.resource.data.kind in ['call', 'check', 'tell', 'quick']
        && request.resource.data.device is string && request.resource.data.device.size() <= 40
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 5
        && request.resource.data.level in ['none', 'watch', 'see_today', 'emergency', 'unknown']
        && (!('turns' in request.resource.data) || request.resource.data.turns.size() <= 400);
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
